family temper-secrets 1

# Tokens, slugs and installation counts share the worker wire ceilings.
# DER uses skein-forge-setup's largest definite-length envelope: 65535 + 4.
# Origin: jig's 253-byte host, colon, and a five-digit port.
# PEM: the former carried bundle's 4096-byte limit less its six-byte header.
record AdminToken { value: secret 4096 }
record ApiToken { value: secret 4096 }
record GitToken { value: secret 4096 }
record User { value: u64 }
record WebhookSecret { value: secret 4096 }
record AppId { value: u64 }
record AppSlug { value: text 1024 }
record AppKey { value: secret 65539 }
record Accepted { values: list 256 u64 }
enum Kind { forgejo, github }
record Origin { kind: Kind api: text 259 }
enum Item {
    admin_token: AdminToken
    api_token: ApiToken
    git_token: GitToken
    user: User
    webhook_secret: WebhookSecret
    app_id: AppId
    app_slug: AppSlug
    app_key: AppKey
    accepted: Accepted
    origin: Origin
}
versioned record Stored { item: Item }
record Pem { value: secret 4090 }
enum PastedItem {
    admin_token: AdminToken
    api_token: ApiToken
    git_token: GitToken
    user: User
    webhook_secret: WebhookSecret
    app_id: AppId
    app_slug: AppSlug
    app_key: AppKey
    accepted: Accepted
    origin: Origin
    pem: Pem
}
versioned record Pasted { item: PastedItem }
