#!/usr/bin/python3
"""Judge the named program account, its worker and every browser trouble entry."""
import json
from pathlib import Path
import sys

def program(document, name):
    accounts = document['accounts']
    # Both the person's program source and its connected worker must agree.
    sources = [source for account in accounts['party'] for source in account['sources']
               if source['kind'] == 'program' and source['name'] == name]
    workers = [login for host in accounts['program_hosts'] if host['connected']
               for login in host['programs'] if login['name'] == name]
    if accounts['usable'] is True and len(sources) == 1 and sources[0]['usable'] is True and workers and all(login['state'] == 'usable' for login in workers):
        return 0, []
    return 1, [{'fail': 'program/not-usable', 'summary': 'The named program source and its connected worker must both be usable.'}]


def trouble(lines):
    entries = [json.loads(line) for line in lines]
    if any(type(entry) is not dict or type(entry.get('kind')) is not str for entry in entries):
        raise ValueError('trouble entry')
    if entries:
        return 1, [{'fail': 'browser/trouble', 'summary': f'{len(entries)} trouble entries: ' + ', '.join(sorted({entry['kind'] for entry in entries}))}]
    return 0, []


def main():
    if len(sys.argv) not in {3, 4} or sys.argv[1] not in {'program', 'trouble'} or len(sys.argv) != (4 if sys.argv[1] == 'program' else 3):
        print('usage: proof trouble FILE | program FILE NAME-FILE', file=sys.stderr)
        return 2
    kind, path = sys.argv[1:3]
    try:
        text = Path(path).read_text(encoding='utf-8')
        if kind == 'program':
            name = Path(sys.argv[3]).read_text(encoding='utf-8').strip()
            if not name:
                raise ValueError('missing program name')
            status, records = program(json.loads(text), name)
        else:
            status, records = trouble(text.splitlines())
    except (OSError, UnicodeError, ValueError, KeyError, TypeError, AttributeError):
        status, records = 2, [{'undecided': f'{kind} evidence missing or unreadable'}]
    for record in records:
        print(json.dumps(record, sort_keys=True, separators=(',', ':')))
    return status


if __name__ == '__main__':
    sys.exit(main())
